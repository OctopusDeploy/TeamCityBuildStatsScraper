step "push-docker-image-tagged-as-version" {
    name = "Push Docker image tagged as version"

    action {
        excluded_environments = ["feed-internal"]
        properties = {
            DockerPush.Source.Docker.Image.Name = "#{Source.Docker.Image.FullName}"
            DockerPush.Source.Docker.Registry.Hostname = "#{Source.Docker.Registry.Hostname}"
            DockerPush.Source.Docker.Registry.Password = "#{Source.Docker.Registry.Password}"
            DockerPush.Source.Docker.Registry.Username = "#{Source.Docker.Registry.Username}"
            DockerPush.Target.Docker.Image.Name = "#{Target.Docker.Image.Name}:#{Octopus.Release.Number}"
            DockerPush.Target.Docker.Registry.Hostname = "#{Target.Docker.Registry.Hostname}"
            DockerPush.Target.Docker.Registry.Password = "#{Target.Docker.Registry.Password}"
            DockerPush.Target.Docker.Registry.Username = "#{Target.Docker.Registry.Username}"
            Octopus.Action.Template.Id = "ActionTemplates-1566"
            Octopus.Action.Template.Version = "14"
        }
        worker_pool = "hosted-ubuntu"

        container {
            feed = "docker-packages-octopushq-com"
            image = "octopusdeploy/tool-containers/tool-skopeo-cli"
        }
    }
}

step "push-docker-image-tagged-as-latest" {
    condition = "Variable"
    name = "Push Docker image tagged as latest"
    properties = {
        Octopus.Step.ConditionVariableExpression = "#{if IsPreRelease}false#{else}true#{/if}"
    }

    action {
        properties = {
            DockerPush.Source.Docker.Image.Name = "#{Source.Docker.Image.FullName}"
            DockerPush.Source.Docker.Registry.Hostname = "#{Source.Docker.Registry.Hostname}"
            DockerPush.Source.Docker.Registry.Password = "#{Source.Docker.Registry.Password}"
            DockerPush.Source.Docker.Registry.Username = "#{Source.Docker.Registry.Username}"
            DockerPush.Target.Docker.Image.Name = "#{Target.Docker.Image.Name}:latest"
            DockerPush.Target.Docker.Registry.Hostname = "#{Target.Docker.Registry.Hostname}"
            DockerPush.Target.Docker.Registry.Password = "#{Target.Docker.Registry.Password}"
            DockerPush.Target.Docker.Registry.Username = "#{Target.Docker.Registry.Username}"
            Octopus.Action.Template.Id = "ActionTemplates-1566"
            Octopus.Action.Template.Version = "14"
        }
        worker_pool = "hosted-ubuntu"

        container {
            feed = "docker-packages-octopushq-com"
            image = "octopusdeploy/tool-containers/tool-skopeo-cli"
        }
    }
}